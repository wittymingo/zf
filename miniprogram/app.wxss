page {
  --bg: #f3f7f4;
  --surface: #ffffff;
  --surface-soft: #f6faf7;
  --text: #15251d;
  --text-2: #33493d;
  --muted: #6c8175;
  --line: #e3ece6;
  --line-strong: #d3e0d8;
  --primary: #0f7a55;
  --primary-strong: #0a6344;
  --pos-bg: #eaf7f0;
  --pos-border: #c9ead9;
  --pos-text: #0e6a4b;
  --neg-bg: #fdeeee;
  --neg-border: #f4d3d3;
  --neg-text: #ad3a3a;

  min-height: 100%;
  background-color: var(--bg);
  background-image: radial-gradient(900px 480px at 50% -8%, #e2f1e8 0%, rgba(226, 241, 232, 0) 65%),
    radial-gradient(700px 420px at 100% 100%, #eef4ef 0%, rgba(238, 244, 239, 0) 70%);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei',
    'Segoe UI', Roboto, sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
input {
  box-sizing: border-box;
}

/* ---------- 通用按钮 ---------- */

.primary-btn {
  width: 100%;
  min-height: 54px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  background: linear-gradient(180deg, #13946a, var(--primary-strong));
  color: #ffffff;
  font-size: 17px;
  font-weight: 700;
  letter-spacing: 0.04em;
  box-shadow: 0 10px 22px rgba(15, 122, 85, 0.22);
}

.primary-btn-hover {
  filter: brightness(1.04);
}

.ghost-btn {
  width: 100%;
  min-height: 46px;
  margin-top: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--line);
  border-radius: 13px;
  background: var(--surface);
  color: var(--text-2);
  font-size: 13px;
}

.ghost-btn-hover {
  border-color: var(--line-strong);
  background: var(--surface-soft);
}

.line-btn {
  min-height: 46px;
  padding: 0 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface);
  color: var(--text-2);
  font-size: 13.5px;
  font-weight: 600;
}

.line-btn-hover {
  border-color: var(--line-strong);
  background: var(--surface-soft);
}

.danger-btn {
  min-height: 46px;
  padding: 0 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--neg-border);
  border-radius: 12px;
  background: var(--neg-bg);
  color: var(--neg-text);
  font-size: 13.5px;
  font-weight: 600;
}

/* ---------- 分段选择 ---------- */

.segmented {
  display: flex;
  gap: 4px;
  padding: 4px;
  border-radius: 13px;
  border: 1px solid var(--line);
  background: var(--surface-soft);
}

.seg-item {
  flex: 1;
  min-height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9px;
  color: var(--muted);
  font-size: 14px;
  font-weight: 600;
}

.seg-item.is-on {
  background: var(--primary);
  color: #ffffff;
  box-shadow: 0 4px 12px rgba(15, 122, 85, 0.24);
}

/* ---------- 弹层 ---------- */

.modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(17, 40, 30, 0.36);
}

.modal-card {
  width: 100%;
  max-width: 420px;
  padding: 22px;
  border-radius: 20px;
  border: 1px solid var(--line);
  background: var(--surface);
  box-shadow: 0 30px 60px rgba(17, 40, 30, 0.24);
}

.modal-title {
  margin: 0 0 8px;
  font-size: 18px;
  font-weight: 700;
  color: var(--text);
}

.modal-text {
  margin: 0 0 14px;
  font-size: 13px;
  line-height: 1.6;
  color: var(--muted);
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 16px;
}
