.match {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 10px 12px calc(20px + env(safe-area-inset-bottom));
}

/* ---------- 顶部操作 ---------- */

.topbar-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4px;
}

.action-btn {
  height: 36px;
  padding: 0 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: var(--surface);
  color: var(--text-2);
  font-size: 12.5px;
  font-weight: 600;
  white-space: nowrap;
  box-shadow: 0 2px 8px rgba(22, 60, 45, 0.05);
}

.action-btn.is-disabled {
  border-color: var(--line);
  background: var(--surface-soft);
  color: #afbdb4;
  box-shadow: none;
}

/* ---------- 状态条 ---------- */

.status-line {
  align-self: center;
  display: flex;
  align-items: center;
  gap: 8px;
  max-width: 100%;
  padding: 5px 12px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--surface);
  color: var(--muted);
  font-size: 12.5px;
}

.status-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-mode {
  flex: none;
  padding: 1px 7px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--surface-soft);
  color: var(--text-2);
  font-size: 10.5px;
  font-weight: 600;
}

/* ---------- 玩家卡片 ---------- */

.board {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.player {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 12px 12px 14px;
  border-radius: 18px;
  border: 1px solid var(--line);
  background: var(--surface);
  box-shadow: 0 10px 26px rgba(22, 60, 45, 0.07), 0 1px 2px rgba(22, 60, 45, 0.04);
  overflow: hidden;
}

.player-accent {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 3px;
}

.player-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 2px 2px 8px;
  border-bottom: 1px solid var(--line);
}

.player-id {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1;
  min-width: 0;
}

.accent-dot {
  width: 8px;
  height: 8px;
  flex-shrink: 0;
  border-radius: 50%;
}

.player-name {
  width: 100%;
  min-width: 0;
  height: 32px;
  min-height: 32px;
  padding: 0 6px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  color: var(--text-2);
  font-size: 16px;
  font-weight: 600;
  letter-spacing: 0.01em;
}

.score {
  flex-shrink: 0;
  min-width: 2ch;
  text-align: right;
  font-size: 38px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--text);
}

.score.is-negative {
  color: var(--neg-text);
}

.score-rows {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.score-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 6px;
}

.score-row.special {
  grid-template-columns: repeat(6, minmax(0, 1fr));
}

.score-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  min-height: 54px;
  padding: 6px 2px;
  border-radius: 12px;
  border: 1px solid;
  font-weight: 600;
  line-height: 1.15;
}

.score-btn .label {
  font-size: 12.5px;
  line-height: 1.1;
  text-align: center;
}

.label-line {
  display: block;
}

.score-btn .delta {
  font-size: 13.5px;
  font-weight: 700;
  opacity: 0.85;
}

.score-btn.plus {
  border-color: var(--pos-border);
  background: var(--pos-bg);
  color: var(--pos-text);
}

.score-btn.minus {
  border-color: var(--neg-border);
  background: var(--neg-bg);
  color: var(--neg-text);
}

.score-btn-hover {
  transform: scale(0.97);
}

/* 三人局多一排特例项，默认就压得比两人局紧 */
.board-3 {
  gap: 6px;
}

.board-3 .player {
  gap: 5px;
  padding: 6px 8px 8px;
  border-radius: 14px;
}

.board-3 .player-head {
  padding: 0 0 4px;
}

.board-3 .player-name {
  height: 28px;
  min-height: 28px;
  padding: 0 4px;
  font-size: 14px;
}

.board-3 .score {
  font-size: 24px;
}

.board-3 .score-rows,
.board-3 .score-row {
  gap: 5px;
}

.board-3 .score-btn {
  min-height: 34px;
  padding: 2px 1px;
  border-radius: 9px;
}

.board-3 .score-btn .label {
  font-size: 10.5px;
}

.board-3 .score-btn .delta {
  font-size: 11px;
}

.board-3 .score-row.special .score-btn {
  min-height: 36px;
  padding: 1px 0;
}

.board-3 .score-row.special .score-btn .label {
  font-size: 9.5px;
  line-height: 1.05;
}

.board-3 .score-row.special .score-btn .delta {
  font-size: 10px;
  line-height: 1;
}

/* 矮屏（约 5.5 寸及以下）：压缩卡片，保证整局一屏放得下 */
@media (max-height: 700px) {
  .board-2 {
    gap: 8px;
  }

  .board-2 .player {
    gap: 8px;
    padding: 10px 10px 12px;
  }

  .board-2 .player-head {
    padding: 0 0 6px;
  }

  .board-2 .score {
    font-size: 32px;
  }

  .board-2 .score-rows {
    gap: 6px;
  }

  .board-2 .score-btn {
    min-height: 44px;
    padding: 4px 2px;
  }

  .board-3 {
    gap: 5px;
  }

  .board-3 .player {
    gap: 4px;
    padding: 5px 7px 6px;
  }

  .board-3 .player-head {
    padding: 0 0 3px;
  }

  .board-3 .player-name {
    height: 24px;
    min-height: 24px;
    font-size: 13px;
  }

  .board-3 .score {
    font-size: 21px;
  }

  .board-3 .score-rows,
  .board-3 .score-row {
    gap: 4px;
  }

  .board-3 .score-btn {
    min-height: 30px;
    padding: 1px 0;
  }

  .board-3 .score-btn .label {
    font-size: 10px;
  }

  .board-3 .score-btn .delta {
    font-size: 10.5px;
  }

  .board-3 .score-row.special .score-btn {
    min-height: 32px;
  }

  .board-3 .score-row.special .score-btn .label {
    font-size: 9px;
    line-height: 1;
  }
}

/* 更矮的屏（4.7/5 寸）：连页面留白和状态条一起收，仍要一屏 */
@media (max-height: 600px) {
  .match {
    gap: 6px;
    padding: 6px 8px calc(12px + env(safe-area-inset-bottom));
  }

  .action-btn {
    height: 32px;
    padding: 0 10px;
    font-size: 12px;
  }

  .status-line {
    padding: 3px 10px;
    font-size: 11.5px;
  }

  .board-3 {
    gap: 4px;
  }

  .board-3 .player {
    gap: 3px;
    padding: 4px 6px 5px;
    border-radius: 12px;
  }

  .board-3 .player-head {
    padding: 0 0 2px;
  }

  .board-3 .player-name {
    height: 22px;
    min-height: 22px;
    font-size: 12.5px;
  }

  .board-3 .score {
    font-size: 20px;
  }

  .board-3 .score-rows,
  .board-3 .score-row {
    gap: 3px;
  }

  .board-3 .score-btn {
    min-height: 26px;
    border-radius: 8px;
  }

  .board-3 .score-btn .label {
    font-size: 9.5px;
  }

  .board-3 .score-btn .delta {
    font-size: 10px;
  }

  .board-3 .score-row.special .score-btn {
    min-height: 28px;
  }

  .board-3 .score-row.special .score-btn .label {
    font-size: 8.5px;
  }

  .board-2 {
    gap: 6px;
  }

  .board-2 .player {
    gap: 6px;
    padding: 8px 8px 10px;
  }

  .board-2 .player-head {
    padding: 0 0 4px;
  }

  .board-2 .player-name {
    height: 26px;
    min-height: 26px;
    font-size: 14px;
  }

  .board-2 .score {
    font-size: 28px;
  }

  .board-2 .score-rows,
  .board-2 .score-row {
    gap: 4px;
  }

  .board-2 .score-btn {
    min-height: 38px;
    padding: 2px 1px;
  }

  .board-2 .score-btn .label {
    font-size: 11px;
  }

  .board-2 .score-btn .delta {
    font-size: 11.5px;
  }
}

/* ---------- 空状态 ---------- */

.center-state {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 24px;
  text-align: center;
}

.center-title {
  font-size: 24px;
  font-weight: 700;
  color: var(--text);
}

.center-text {
  font-size: 14px;
  line-height: 1.6;
  color: var(--muted);
}

.center-btn {
  width: auto;
  min-height: 46px;
  margin-top: 6px;
  padding: 0 24px;
  font-size: 15px;
}

/* ---------- 统计 ---------- */

.stats-card {
  max-width: 460px;
  display: flex;
  flex-direction: column;
}

.stats-tabs {
  display: flex;
  gap: 4px;
  padding: 4px;
  margin-bottom: 12px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface-soft);
}

.stats-tab {
  flex: 1;
  min-height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9px;
  color: var(--muted);
  font-size: 13px;
  font-weight: 600;
}

.stats-tab.is-on {
  background: var(--surface);
  color: var(--text);
  box-shadow: 0 2px 8px rgba(22, 60, 45, 0.08);
}

.stats-panel {
  height: 48vh;
}

.verdict {
  margin-bottom: 12px;
  padding: 12px 14px;
  border: 1px solid var(--pos-border);
  border-radius: 12px;
  background: var(--pos-bg);
  color: var(--pos-text);
  font-size: 14px;
  font-weight: 700;
  text-align: center;
}

.verdict.is-neutral {
  border-color: var(--line);
  background: var(--surface-soft);
  color: var(--muted);
  font-weight: 500;
}

.verdict-sub {
  margin: -6px 0 12px;
  text-align: center;
  font-size: 12px;
  color: var(--muted);
}

.diff-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.diff-row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 12px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface-soft);
}

.diff-rank {
  width: 16px;
  flex-shrink: 0;
  font-size: 11.5px;
  color: var(--muted);
  text-align: center;
}

.diff-name {
  flex: 1;
  min-width: 0;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.diff-score {
  flex-shrink: 0;
  font-size: 12.5px;
  color: var(--muted);
}

.diff-value {
  min-width: 48px;
  flex-shrink: 0;
  text-align: right;
  font-size: 16px;
  font-weight: 700;
  color: var(--muted);
}

.diff-value.is-plus {
  color: var(--pos-text);
}

.diff-value.is-minus {
  color: var(--neg-text);
}

.stats-note {
  margin-bottom: 12px;
  font-size: 11.5px;
  line-height: 1.5;
  color: var(--muted);
}

.diff-note {
  margin: 10px 0 0;
}

.tip-title {
  margin: 16px 0 6px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: var(--text-2);
}

.tip-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding-bottom: 4px;
  font-size: 12.5px;
  line-height: 1.6;
  color: var(--text-2);
}

.tip-item {
  padding-left: 14px;
  position: relative;
}

.tip-item::before {
  content: '·';
  position: absolute;
  left: 2px;
  color: var(--primary);
  font-weight: 700;
}

.stats-player {
  margin-bottom: 10px;
  padding: 10px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--surface-soft);
}

.stats-head {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 8px;
}

.stats-name {
  flex: 1;
  min-width: 0;
  font-size: 13.5px;
  font-weight: 600;
  color: var(--text-2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stats-total {
  flex-shrink: 0;
  font-size: 11.5px;
  color: var(--muted);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 6px;
}

.stat-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: 6px 2px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: var(--surface);
}

.stat-label {
  font-size: 10.5px;
  line-height: 1.2;
  color: var(--muted);
  text-align: center;
  word-break: break-word;
}

.stat-count {
  font-size: 15px;
  font-weight: 700;
  line-height: 1.1;
  color: var(--text);
}

.stat-count.is-zero {
  color: #b5c2b9;
  font-weight: 600;
}
